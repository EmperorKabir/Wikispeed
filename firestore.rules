rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function sessionDoc(code) {
      return get(/databases/$(database)/documents/sessions/$(code)).data;
    }

    function validPage(page) {
      return page is map
        && page.keys().hasOnly(['key', 'title'])
        && page.key is string && page.key.size() > 0 && page.key.size() <= 300
        && page.title is string && page.title.size() > 0 && page.title.size() <= 300;
    }

    function validSession(d) {
      return d.keys().hasOnly(['mode', 'scoring', 'difficulty', 'host', 'hideStart', 'hideTarget', 'start', 'target', 'status', 'createdAt', 'startedAt'])
        && d.mode in ['solo', 'multi']
        && d.scoring in ['time', 'clicks']
        && d.difficulty in ['easy', 'medium', 'hard', 'any']
        && d.host == request.auth.uid
        && d.hideStart is bool && d.hideTarget is bool
        && (d.hideStart ? d.start == null : validPage(d.start))
        && (d.hideTarget ? d.target == null : validPage(d.target))
        && d.status == (d.mode == 'solo' ? 'open' : 'lobby')
        && d.createdAt == request.time
        && (d.startedAt == null || d.startedAt == request.time);
    }

    function validRun(d) {
      return d.keys().hasOnly(['uid', 'attempt', 'name', 'clicks', 'ms', 'path', 'done', 'quit', 'startedAt', 'finishedAt'])
        && d.uid is string
        && d.attempt is int && d.attempt >= 1
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 32
        && d.clicks is int && d.clicks >= 0
        && d.ms is number && d.ms >= 0
        && d.path is list && d.path.size() <= 500
        && d.done is bool
        && d.quit is bool
        && (d.startedAt == null || d.startedAt is timestamp)
        && (d.finishedAt == null || d.finishedAt is timestamp);
    }

    function honestResult(d, before) {
      return d.ms <= request.time.toMillis() - before.startedAt.toMillis()
        && (d.path.size() == 500 ? d.clicks >= 499 : d.clicks == d.path.size() - 1);
    }

    function validHistory(d) {
      return d.keys().hasOnly(['mode', 'scoring', 'difficulty', 'start', 'target', 'clicks', 'ms', 'done', 'attempts', 'at'])
        && d.difficulty in ['easy', 'medium', 'hard', 'any']
        && d.attempts is int && d.attempts >= 1
        && d.mode in ['solo', 'multi']
        && d.scoring in ['time', 'clicks']
        && d.start is string && d.start.size() <= 300
        && d.target is string && d.target.size() <= 300
        && d.clicks is int && d.clicks >= 0
        && d.ms is number && d.ms >= 0
        && d.done is bool
        && d.at == request.time;
    }

    match /sessions/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && code.matches('^[A-HJ-NP-Z2-9]{6}$')
        && validSession(request.resource.data);
      allow update: if signedIn()
        && resource.data.host == request.auth.uid
        && resource.data.status == 'lobby'
        && request.resource.data.status == 'open'
        && request.resource.data.startedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'startedAt']);
      allow delete: if false;

      match /private/route {
        allow get: if signedIn()
          && (sessionDoc(code).host == request.auth.uid || sessionDoc(code).status == 'open');
        allow list: if false;
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['start', 'target'])
          && validPage(request.resource.data.start)
          && validPage(request.resource.data.target)
          && getAfter(/databases/$(database)/documents/sessions/$(code)).data.host == request.auth.uid;
        allow update, delete: if false;
      }

      match /players/{uid} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name', 'joinedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 32
          && request.resource.data.joinedAt == request.time;
        allow delete: if false;
      }

      match /runs/{runId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && validRun(request.resource.data)
          && request.resource.data.uid == request.auth.uid
          && runId == request.auth.uid + '-' + string(request.resource.data.attempt)
          && sessionDoc(code).status == 'open'
          && request.resource.data.done == false
          && request.resource.data.quit == false
          && request.resource.data.clicks == 0
          && request.resource.data.ms == 0
          && request.resource.data.path.size() == 1
          && request.resource.data.startedAt == request.time
          && request.resource.data.finishedAt == null;
        allow update: if signedIn()
          && resource.data.uid == request.auth.uid
          && resource.data.done == false
          && resource.data.quit == false
          && validRun(request.resource.data)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.attempt == resource.data.attempt
          && request.resource.data.startedAt == resource.data.startedAt
          && request.resource.data.finishedAt == request.time
          && (request.resource.data.done || request.resource.data.quit)
          && honestResult(request.resource.data, resource.data);
        allow delete: if false;
      }
    }

    match /users/{uid}/history/{code} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid && validHistory(request.resource.data);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
